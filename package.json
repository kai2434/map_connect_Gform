{
  "name": "regional-photo-spot-submission",
  "private": true,
  "version": "1.0.0",
  "description": "地域別写真撮影地点投稿Webサイト（地理院タイル + Leaflet + TypeScript + Googleフォーム事前入力連携）",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev-server.mjs --dist",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:run": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "happy-dom": "^17.4.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.8.2"
  }
}
